# Copy to .env (untracked) and fill in real values before running docker-compose.prod.yml.

# Which GHCR package/tag to pull. Lowercase, matches the "<owner>/<repo>" the CI workflow
# derives from github.repository - see .github/workflows/ci.yml.
GHCR_REPO=lensimax/paragliding-logbook
IMAGE_TAG=dev

# Postgres password shared by the db and backend services. Anything strong and unique - it's
# only ever used inside the compose network.
POSTGRES_PASSWORD=

# Pepper mixed into every public activity/user ID (see backend/src/ParagLog.Core - PublicIdGenerator).
# Generate once, keep it stable forever: rotating it changes every public ID already handed out.
# e.g. openssl rand -base64 32
ACCOUNTS_PUBLIC_ID_SERVER_SALT=
